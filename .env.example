# Copy to .env and adjust before running docker compose up.

# --- Database -----------------------------------------------------------------
DB_NAME=printerupkeep
DB_USER=printerupkeep
# REQUIRED: choose a strong password
DB_PASSWORD=
# Postgres schema the app creates and uses for all its tables, keeping them
# isolated from `public` (useful on a shared Supabase database). Default is
# fine; only change it if you need a different schema name.
DB_SCHEMA=printerupkeep

# --- API ------------------------------------------------------------------------
# REQUIRED: long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_TTL=12h

# --- Initial admin account (created only on first boot, when no users exist) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

# --- Document storage -----------------------------------------------------------
# Where uploaded documents (attachments, signed requisitions, quotations) live.
#   disk     : local uploads volume (default, no extra config)
#   supabase : Supabase Storage bucket
# Leave STORAGE_DRIVER blank to auto-select supabase when the SUPABASE_* values
# below are set, otherwise disk.
STORAGE_DRIVER=
# Base URL of the Supabase (Kong) gateway, e.g. https://supabase.example.com
SUPABASE_URL=
# service_role key (Supabase project → Settings → API). Required for supabase
# storage; keep it secret — it bypasses row-level security.
SUPABASE_SERVICE_KEY=
# Bucket that holds uploaded documents. Create it in Supabase first.
SUPABASE_STORAGE_BUCKET=PrinterLogs

# --- Web -------------------------------------------------------------------------
# Host port the app is served on for a local/direct `docker compose up`
# (http://<server>:WEB_PORT). On a managed host the platform proxy handles this.
WEB_PORT=8000

# Pre-built web image pulled on managed hosts (built by GitHub Actions and
# published to GHCR). Override to pin a specific tag or digest, e.g.
#   WEB_IMAGE=ghcr.io/laurencepeter/printerupkeep-web:sha-<commit>
# Local `docker compose up --build` ignores this and builds web from ./app.
WEB_IMAGE=ghcr.io/laurencepeter/printerupkeep-web:main
